on init && property:ro.bootmode=charger
    write /sys/class/graphics/fb0/blank 0

on property:init.svc.vendor.charger=running
    write /sys/class/leds/lcd-backlight/brightness 1000
    write /sys/class/leds/lcd-backlight/trigger "backlight"

    # Set power saving parameters
    write /sys/devices/platform/10012000.dvfsrc/helio-dvfsrc/dvfsrc_debug "kir_emi -1"

    # Keep one LITTLE (cpu0) and one big (cpu6)
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
    write /sys/devices/system/cpu/cpu4/online 0
    write /sys/devices/system/cpu/cpu5/online 0
    write /sys/devices/system/cpu/cpu7/online 0

on init
    # Disable UFS powersaving during boot
    write /sys/devices/platform/11270000.ufshci/clkgate_enable 0

    # Increase socket buffers for better network performance
    write /proc/sys/net/core/wmem_max 8388608
    write /proc/sys/net/core/rmem_max 8388608

    # Configure CPU governors for both clusters
    chmod 0644 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0644 /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/schedutil/down_rate_limit_us 90000

    # Configure cpuset groups for task placement
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/foreground/boost/cpus 0-7
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/restricted/cpus 0-3
    write /dev/stune/top-app/schedtune.boost 1

    # Fastcharge configuration
    write /proc/vooc_fw_check 1
    write /proc/ui_soc_decimal 1
    write /proc/fastchg_fw_update 1

    # Create stune directories for scheduler tuning
    mkdir /dev/stune/foreground
    mkdir /dev/stune/background
    mkdir /dev/stune/top-app
    mkdir /dev/stune/rt
    mkdir /dev/stune/io

    # Set permissions for stune directories (simplified)
    chown system system /dev/stune/foreground
    chown system system /dev/stune/background
    chown system system /dev/stune/top-app
    chown system system /dev/stune/rt
    chown system system /dev/stune/io
    chmod 0664 /dev/stune/foreground/tasks
    chmod 0664 /dev/stune/background/tasks
    chmod 0664 /dev/stune/top-app/tasks
    chmod 0664 /dev/stune/rt/tasks
    chmod 0666 /dev/stune/io/tasks

    # Reset stune group setting for NNAPI HAL processes
    write /dev/stune/nnapi-hal/schedtune.boost 0
    write /dev/stune/nnapi-hal/schedtune.prefer_idle 0

on late-init
    # Enable expedited RCU processing
    write /sys/kernel/rcu_expedited 1

on post-fs-data
    # Boot time storage tuning
    write /sys/block/sdc/queue/iostats 0
    write /sys/block/sdc/queue/nr_requests 256

    # Boot time performance boost
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "0 100"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "1 100"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "2 100"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "3 100"

    # Power management settings
    write /sys/power/pm_async 0
    write /sys/power/pm_freeze_timeout 2000

    # Set mlock limits for various services
    setrlimit 8 67108864 67108864  # For netd
    setrlimit 8 -1 -1              # For m4u operation

on boot
    # Set permissions for power management interfaces
    chown system system /sys/power/autosleep
    chown system system /sys/power/state
    chown system system /sys/power/wakeup_count
    chown radio wakelock /sys/power/wake_lock
    chown radio wakelock /sys/power/wake_unlock
    chmod 0660 /sys/power/autosleep
    chmod 0660 /sys/power/state
    chmod 0660 /sys/power/wake_lock
    chmod 0660 /sys/power/wake_unlock
    chmod 0660 /sys/power/wakeup_count
    
    # VM tuning
    write /proc/sys/vm/dirty_writeback_centisecs 300

on property:sys.boot_completed=1
    # Runtime storage tuning
    write /sys/block/sdc/queue/iostats 1
    write /sys/block/sdc/queue/nr_requests 128

    # Reset SchedTune preferences
    write /dev/stune/foreground/schedtune.prefer_idle 0
    write /dev/stune/top-app/schedtune.prefer_idle 0
    write /dev/stune/rt/schedtune.prefer_idle 0
    write /proc/sys/kernel/sched_migration_cost_ns 200000

    # Disable boot boost
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "0 0"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "1 0"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "2 0"
    write /proc/perfmgr/boost_ctrl/eas_ctrl/boot_boost "3 0"
    
    # DDR OPP setting
    write /sys/devices/platform/10012000.dvfsrc/helio-dvfsrc/dvfsrc_req_ddr_opp -1

    # Enable big task rotation
    write /proc/perfmgr/boost_ctrl/eas_ctrl/sched_big_task_rotation 1

    # GPU DVFS configuration
    write /sys/kernel/ged/hal/dvfs_margin_value 130
    write /sys/kernel/ged/hal/timer_base_dvfs_margin 798
    write /sys/kernel/ged/hal/loading_base_dvfs_step 4

    # ZRAM configuration
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 60
    write /proc/sys/vm/watermark_scale_factor 125
    write /sys/kernel/mm/swap/vma_ra_enabled false

    # Initialize ZRAM
    swapon_all /vendor/etc/fstab.zram

    # VM cache and dirty page settings
    write /proc/sys/vm/vfs_cache_pressure 40
    write /proc/sys/vm/dirty_ratio 15
    write /proc/sys/vm/dirty_background_ratio 5

    # Initialize PowerHAL
    setprop vendor.powerhal.init 1
    
# Service definitions
service vendor.gralloc-4-0 /vendor/bin/hw/android.hardware.graphics.allocator@4.0-service-mediatek
    class hal animation
    interface android.hardware.graphics.allocator@4.0::IAllocator default
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ProcessCapacityHigh HighPerformance
    override

service vendor.hwcomposer-2-2 /vendor/bin/hw/android.hardware.graphics.composer@2.2-service
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ProcessCapacityHigh HighPerformance
    override

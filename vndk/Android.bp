cc_prebuilt_library_shared {
    name: "libcrypto-v32",
    target: {
        android_arm64: {
            srcs: ["arm64/libcrypto-v32.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "libssl-v32",
    target: {
        android_arm64: {
            srcs: ["arm64/libssl-v32.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    vendor: true,
}

cc_binary {
    name: "vendor.lineage.touch-service.salaa",
    init_rc: ["vendor.lineage.touch-service.salaa.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.salaa.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "HighTouchPollingRate.cpp",
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}

dontaudit untrusted_app proc:file r_file_perms;
dontaudit untrusted_app vendor_file:file r_file_perms;

allow untrusted_app sysfs:dir r_dir_perms;
allow untrusted_app sysfs:file r_file_perms;
allow untrusted_app sysfs_devices_block:file r_file_perms;
allow untrusted_app sysfs_gpu:dir search;
allow untrusted_app sysfs_batteryinfo:dir search;
allow untrusted_app sysfs_soc:dir search;
allow untrusted_app sysfs_soc:file r_file_perms;
allow untrusted_app proc_gpufreq:dir search;
allow untrusted_app proc_gpufreq:file r_file_perms;
allow untrusted_app proc_cpufreq:dir search;
allow untrusted_app proc_cpufreq:file r_file_perms;
allow untrusted_app proc_zoneinfo:file r_file_perms;
allow untrusted_app proc_asound:dir search;
allow untrusted_app proc_interrupts:file r_file_perms;
allow untrusted_app proc_version:file r_file_perms;
allow untrusted_app vendor_sysfs_battery_supply:dir search;
allow untrusted_app vendor_sysfs_battery_supply:file r_file_perms;
allow untrusted_app vendor_proc_batt_param:file { getattr read };
allow untrusted_app vendor_proc_charger:dir r_file_perms;
allow untrusted_app vendor_proc_charger:file { getattr read };
allow untrusted_app vendor_proc_display:dir { search read };
allow untrusted_app vendor_proc_display:file r_file_perms;
allow untrusted_app vendor_proc_nfc_chipset:file { read getattr };
allow untrusted_app vendor_proc_oplus_sensor_feature:dir search;
allow untrusted_app vendor_proc_oplus_sensor_feature:file r_file_perms;
allow untrusted_app vendor_proc_oplus_version:dir r_dir_perms;
allow untrusted_app zygote:unix_stream_socket { getopt };
allow untrusted_app wifi_hal_prop:file { read open };

dontaudit untrusted_app proc:dir r_dir_perms;
dontaudit untrusted_app proc:file r_file_perms;
dontaudit untrusted_app sysfs:dir r_dir_perms;
dontaudit untrusted_app sysfs:file r_file_perms;

allow untrusted_app apk_data_file:file ioctl;
allow untrusted_app apk_data_file:file execute;
allow untrusted_app media_rw_data_file:file relabelfrom;
allow untrusted_app sysfs_devices_block:file { read open };
allow untrusted_app sysfs_batteryinfo:dir search;
allow untrusted_app sysfs_batteryinfo:file { read open };
allow untrusted_app sysfs_soc:dir search;
allow untrusted_app sysfs_soc:file { read open };
allow untrusted_app sysfs_gpu:dir r_dir_perms;
allow untrusted_app sysfs_gpu:file rw_file_perms;
allow untrusted_app proc_version:file { read open };
allow untrusted_app proc_gpufreq:dir search;
allow untrusted_app proc_gpufreq:file { read open };
allow untrusted_app proc_cpufreq:dir search;
allow untrusted_app proc_cpufreq:file { read open };
allow untrusted_app proc_zoneinfo:file { read open };
allow untrusted_app proc_asound:dir search;
allow untrusted_app proc_asound:file { read open };
allow untrusted_app proc_interrupts:file { read open };
allow untrusted_app proc_filesystems:file { read open };
allow untrusted_app proc_filesystems:file getattr;
allow untrusted_app proc_bus_input:file read;
allow untrusted_app proc_tty_drivers:file read;
allow untrusted_app vendor_sysfs_gpu:dir search;
allow untrusted_app vendor_sysfs_gpu:file rw_file_perms;
allow untrusted_app vendor_file:file { read open };
allow untrusted_app vendor_sysfs_battery_supply:dir search;
allow untrusted_app vendor_sysfs_battery_supply:file { read open };
allow untrusted_app vendor_proc_batt_param:file { getattr read };
allow untrusted_app vendor_proc_charger:dir { read open };
allow untrusted_app vendor_proc_charger:file { getattr read };
allow untrusted_app vendor_proc_display:dir { search read };
allow untrusted_app vendor_proc_display:file { read open };
allow untrusted_app vendor_proc_nfc_chipset:file { read getattr };
allow untrusted_app vendor_proc_oplus_sensor_feature:dir search;
allow untrusted_app vendor_proc_oplus_sensor_feature:file { read open };
allow untrusted_app vendor_proc_oplus_version:dir { read open };
allow untrusted_app vendor_mtk_soc_prop:file { read open };
allow untrusted_app userdebug_or_eng_prop:file { read open };
allow untrusted_app wifi_hal_prop:file { read open };
allow untrusted_app wifi_hal_prop:file getattr;
allow untrusted_app zygote:unix_stream_socket { getopt };

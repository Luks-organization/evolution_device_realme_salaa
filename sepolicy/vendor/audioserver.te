allow audioserver audio_device:chr_file r_file_perms;
allow audioserver audio_service:service_manager find;
allow audioserver unlabeled:dir search;
allow audioserver unlabeled:file { read write open getattr };
allow hal_audio_default hal_audio_default:process { execmem };

get_prop(audioserver, vendor_mtk_besloudness_support_prop)
get_prop(audioserver, vendor_mtk_hifiaudio_support_prop)
get_prop(audioserver, vendor_mtk_audiohal_prop)
get_prop(audioserver, vendor_mtk_audio_prop)
get_prop(audioserver, vendor_default_prop)

# for external camera
binder_call(cameraserver, mtk_hal_camera)

allow cameraserver property_socket:sock_file rw_file_perms;
allow cameraserver adb_data_file:file rw_file_perms;
allow cameraserver vendor_oplus_prop:file { read open };

get_prop(platform_app, vendor_oplus_prop)
set_prop(platform_app, vendor_oplus_prop)

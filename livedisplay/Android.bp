cc_binary {
    name: "vendor.lineage.livedisplay@2.1-service-salaa",
    init_rc: ["vendor.lineage.livedisplay@2.1-service-salaa.rc"],
    vintf_fragments: ["vendor.lineage.livedisplay@2.1-service-salaa.xml"],
    vendor: true,
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    shared_libs: [
        "libbase",
        "libbinder",
        "libcutils",
        "libhidlbase",
        "libutils",
        "vendor.lineage.livedisplay@2.0",
        "vendor.lineage.livedisplay@2.1",
    ],

    srcs: [
        "AntiFlicker.cpp",
        "SunlightEnhancement.cpp",
        "service.cpp",
    ]
}

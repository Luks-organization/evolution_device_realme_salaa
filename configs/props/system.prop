# AEE
ro.vendor.have_aee_feature=1

# APK Verity
ro.apk_verity.mode=2

# Audio
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
audio.spatializer.effect.util_clamp_min=300
persist.sys.audio.out.vol=7
ro.audio.headtracking_enabled=true
ro.audio.silent=0
ro.audio.spatializer_enabled=true
ro.audio.spatializer_transaural_enabled_default=true
ro.audio.spatializer_binaural_enabled_default=true
ro.audio.spatializer_enabled=true
ro.audio.usb.period_us=16000
ro.camera.sound.forced=0
ro.config.hd_voicemail=1
ro.config.media_vol_steps=25
ro.config.vc_call_vol_steps=10
ro.mtk_audenh_support=1
ro.mtk_audio_lossless_support=1
ro.mtk_besloudness_support=1

# Touch
MultitouchMinDistance=1px
MultitouchSettleInterval=1ms
TapInterval=1ms
TapSlop=1px
touch.coverage.calibration=box
touch.distance.calibration=none
touch.distance.scale=0
touch.gestureMode=spots
touch.pressure.scale=0.001
touch.size.bias=0
touch.size.isSummed=0
touch.size.scale=1

# Display
debug.composition.type=gpu
persist.sys.sf.color_mode=9
persist.sys.sf.color_saturation=1.0
persist.sys.sf.native_mode=2
ro.hardware.egl=meow
ro.hardware.vulkan=mt6785
ro.launcher.blur.appLaunch=0
ro.opengles.version=196610
ro.sf.blurs_are_expensive=1

# SurfaceFlinger
debug.graphics.game_default_frame_rate.disabled=true
debug.sf.recomputecrop=0
debug.sf.auto_latch_unsignaled=0
debug.sf.defer_refresh_rate_when_off=1
debug.sf.disable_backpressure=1
debug.sf.disable_client_composition_cache=0
debug.sf.early.app.duration=20000000
debug.sf.early.sf.duration=27600000
debug.sf.earlyGl.app.duration=20000000
debug.sf.earlyGl.sf.duration=27600000
debug.sf.enable_adpf_cpu_hint=true
debug.sf.enable_advanced_sf_phase_offset=1
debug.sf.enable_auto_power_mode=1
debug.sf.enable_egl_image_tracker=0
debug.sf.enable_gl_backpressure=0
debug.sf.enable_hwc_vds=0
debug.sf.enable_transaction_tracing=false
debug.sf.frame_rate_multiple_threshold=90
debug.sf.hw=1
debug.sf.hwc.min.duration=23000000
debug.sf.latch_unsignaled=0
debug.sf.late.app.duration=20000000
debug.sf.late.sf.duration=27600000
debug.sf.predict_hwc_composition_strategy=0
debug.sf.treat_170m_as_sRGB=1
debug.sf.use_phase_offsets_as_durations=1
debug.sf.layer_caching_active_layer_timeout_ms=1000

# HWUI
debug.hwui.trace_gpu_resources=false
debug.hwui.render_dirty_regions=true
debug.hwui.renderer=opengl
debug.hwui.skia_atrace_enabled=false
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
debug.hwui.target_cpu_time_percent=30
debug.hwui.use_hint_manager=true
ro.hwui.disable_sc=false
ro.hwui.render_ahead=10

# SkiaGL
debug.renderengine.backend=skiaglthreaded
renderthread.skia.reduceopstasksplitting=true

# Camera
persist.camera.HAL3.enabled=1
persist.camera.eis.enable=1
persist.vendor.camera.privapp.list=com.android.camera,com.google.camera,org.lineageos.aperture,org.lineageos.aperture.dev
ro.camera.hfr.enable=1
ro.camera.high.resolution.video.filter.enable=1
ro.camera.ignore.input.stream.check.enable=1
ro.camera.portrait.blur.level.enable=1
ro.camera.temperature.limit=440
ro.camera.videoeis.enable=
ro.mtk_cam.mfb.ultimate=1
vendor.camera.aux.packageexcludelist=org.telegram.messenger,com.microsoft.teams,com.discord,us.zoom.videomeetings
vendor.camera.aux.packagelist=com.android.camera,com.google.camera,org.lineageos.aperture,org.lineageos.aperture.dev

# Memory management
persist.sys.fw.bg_apps_limit?=48
persist.sys.fw.bservice_age?=120000
persist.sys.fw.bservice_enable?=true
persist.sys.fw.bservice_limit?=6
persist.sys.fw.empty_app_percent?=50
persist.sys.fw.trim_cache_percent?=100
persist.sys.fw.trim_empty_percent?=100
persist.sys.fw.trim_enable_memory?=2147483648
persist.sys.fw.use_trim_settings?=true

# Mediatek
persist.vendor.mdlog.flush_log_ratio=0
persist.vendor.pms_removable=1
persist.vendor.vzw_device_type=0
qemu.hw.mainkeys=0
ro.mediatek.version.branch=alps-mp-s0.mssi1.tc16sp-pr6
ro.support_one_handed_mode=true
ro.vendor.mtk_cta_set=1
ro.vendor.mtk_gwsd_support=1
ro.vendor.mtk_omacp_support=1

# RIL
persist.radio.hvolte.enable=1
persist.radio.multisim.config=dsds
ro.telephony.sim.count=2
ro.vendor.mtk_telephony_add_on_policy=0
vendor.rild.libargs=-d /dev/ttyC0
vendor.rild.libpath=/vendor/lib64/libmtk-ril.so

# WiFi
mediatek.wlan.ctia=0
persist.data.iwlan.ipsec.ap=1
persist.vendor.wfc.sys_wfc_support=1
ro.mediatek.wlan.p2p=1
ro.mediatek.wlan.wsc=1
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.supplicant_scan_interval=15
wifi.tethering.interface=ap0

# USB
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp

# ADB
#persist.service.debuggable=1
persist.adb.nonblocking_ffs=0
persist.service.adb.enable=1
persist.sys.usb.config=mtp,adb

# Zygote
persist.device_config.runtime_native.usap_pool_enabled=true
ro.zygote.preload.enable=0
zygote.critical_window.minute=10

# LMKD
persist.sys.lmk.reportkills=false
ro.lmk.log_stats=true
sys.lmk.reportkills=0

# Radio
persist.sys.radio.force_lte_ca=true
persist.vendor.radio.telecom.vibrate=0

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# Dex2oat
dalvik.vm.dex2oat64.enabled=true
pm.dexopt.bg-dexopt=everything

# Storage
persist.sys.fuse.passthrough.enable=true

# IPO
sys.ipo.disable=1
sys.ipo.pwrdncap=2

# iorapd
ro.iorapd.enable=false

# Memory
ro.config.per_app_memcg=false

# Power Saving Mode
ro.power_profile.override=power-save

# Ram
ro.config.hw_ram=true

# Display Refresh Rate
persist.sys.display-rate=90

# Charger
ro.charger.enable_suspend=true

# System properties
ro.product.property_source_order=odm,vendor,product,system_ext,system

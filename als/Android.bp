aidl_interface {
    name: "vendor.lineage.oplus_als",
    vendor_available: true,
    srcs: ["vendor/lineage/oplus_als/*.aidl"],
    stability: "vintf",
    owner: "lineage",
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
